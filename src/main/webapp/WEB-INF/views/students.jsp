<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Students | CampusFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body>
<%@ include file="nav.jspf" %><main class="page-shell"><div class="page-heading"><div><p class="eyebrow">DIRECTORY</p><h1>Student management</h1><p class="muted">Create, review, and maintain student records.</p></div><a class="button button-primary" href="${pageContext.request.contextPath}/students?action=new">+ Add student</a></div>
<c:if test="${param.saved != null}"><div class="success">Student record saved successfully.</div></c:if><c:if test="${param.deleted != null}"><div class="success">Student record deleted.</div></c:if>
<section class="panel"><form class="search-form" method="get" action="${pageContext.request.contextPath}/students"><input type="search" name="q" value="<c:out value='${query}'/>" placeholder="Search name, enrollment, email or department"><button class="button button-secondary" type="submit">Search</button><a class="button button-quiet" href="${pageContext.request.contextPath}/students">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>ENROLLMENT</th><th>DEPARTMENT</th><th>SEMESTER</th><th>ACTIONS</th></tr></thead><tbody>
<c:forEach var="s" items="${students}"><tr><td><strong><c:out value="${s.fullName}"/></strong><small><c:out value="${s.email}"/></small></td><td><c:out value="${s.enrollmentNo}"/></td><td><c:out value="${s.department}"/></td><td><span class="pill">Sem ${s.semester}</span></td><td class="actions"><a class="text-link" href="${pageContext.request.contextPath}/students?action=edit&id=${s.id}">Edit</a><form method="post" action="${pageContext.request.contextPath}/students" onsubmit="return confirm('Delete this student record?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${s.id}"><button class="text-link danger-link" type="submit">Delete</button></form></td></tr></c:forEach>
<c:if test="${empty students}"><tr><td colspan="5" class="empty-state">No student records found. Try another search or add a student.</td></tr></c:if>
</tbody></table></div></section></main></body></html>