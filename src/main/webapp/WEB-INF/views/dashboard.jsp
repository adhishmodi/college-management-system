<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard | CampusFlow</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body>
<%@ include file="nav.jspf" %><main class="page-shell"><div class="page-heading"><div><p class="eyebrow">OVERVIEW</p><h1>Good to see you, <c:out value="${sessionScope.user.fullName}"/>.</h1><p class="muted">Here is what's happening in your campus workspace.</p></div></div>
<c:if test="${sessionScope.user.admin}"><section class="stats-grid"><article class="stat-card"><span class="stat-label">TOTAL STUDENTS</span><strong class="stat-value">${studentCount}</strong><span class="stat-foot">Registered in the system</span></article><article class="stat-card"><span class="stat-label">YOUR ROLE</span><strong class="stat-value">Admin</strong><span class="stat-foot">Full student management access</span></article><article class="stat-card"><span class="stat-label">PORTAL STATUS</span><strong class="stat-value status-live">● Active</strong><span class="stat-foot">Connected to campus database</span></article></section>
<section class="panel welcome-panel"><div><p class="eyebrow">QUICK ACTION</p><h2>Manage your students</h2><p class="muted">Add new student records, update details, or search the directory.</p></div><a class="button button-primary" href="${pageContext.request.contextPath}/students">Open student directory →</a></section></c:if>
<c:if test="${!sessionScope.user.admin}"><section class="panel welcome-panel"><div><p class="eyebrow">STUDENT PORTAL</p><h2>You are signed in.</h2><p class="muted">Your account is active. Contact the college administrator if you need to update your student details.</p></div></section></c:if>
</main></body></html>